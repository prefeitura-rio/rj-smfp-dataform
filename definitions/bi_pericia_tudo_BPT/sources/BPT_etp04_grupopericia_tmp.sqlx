        WHEN GRUPO_PERICIA_DESC = 'READAPTAÇÃO - RD' AND TIPO_ATENDIMENTO = 'PROCESSO' THEN 'PROCESSO'
        WHEN GRUPO_PERICIA_DESC = 'READAPTAÇÃO - RD' AND TIPO_ATENDIMENTO = 'JUNTA' THEN 'JUNTA MÉDICA'
        WHEN GRUPO_PERICIA_DESC = 'READAPTAÇÃO - RD' AND TIPO_ATENDIMENTO = 'JUNTA' THEN 'JUNTA MÉDICA'
        WHEN GRUPO_PERICIA_DESC = 'READAPTAÇÃO - RD' AND TIPO_ATENDIMENTO = 'JUNTA' THEN 'JUNTA MÉDICA'
        WHEN GRUPO_PERICIA_DESC = 'READAPTAÇÃO - RD' AND TIPO_ATENDIMENTO = 'JUNTA' THEN 'JUNTA MÉDICA'
        WHEN GRUPO_PERICIA_DESC = 'READAPTAÇÃO - RD' AND TIPO_ATENDIMENTO = 'PROCESSO' THEN 'PROCESSO'
        WHEN GRUPO_PERICIA_DESC = 'READAPTAÇÃO - RD' AND TIPO_ATENDIMENTO = 'PROCESSO' THEN 'PROCESSO'
        WHEN GRUPO_PERICIA_DESC = 'REDUÇÃO CH - RCH' AND TIPO_ATENDIMENTO = 'PROCESSO' THEN 'PROCESSO'
        WHEN GRUPO_PERICIA_DESC = 'REDUÇÃO CH - RCH' AND TIPO_ATENDIMENTO = 'JUNTA' THEN 'JUNTA MÉDICA'
        WHEN GRUPO_PERICIA_DESC = 'REDUÇÃO CH - RCH' AND TIPO_ATENDIMENTO = 'JUNTA' THEN 'JUNTA MÉDICA'
        WHEN GRUPO_PERICIA_DESC = 'REDUÇÃO CH - RCH' AND TIPO_ATENDIMENTO = 'JUNTA' THEN 'JUNTA MÉDICA'
        WHEN GRUPO_PERICIA_DESC = 'REDUÇÃO CH - RCH' AND TIPO_ATENDIMENTO = 'JUNTA' THEN 'JUNTA MÉDICA'
        WHEN GRUPO_PERICIA_DESC = 'REDUÇÃO CH - RCH' AND TIPO_ATENDIMENTO = 'PROCESSO' THEN 'PROCESSO'
        WHEN GRUPO_PERICIA_DESC = 'RETIFICAÇÃO' AND TIPO_ATENDIMENTO = 'LM' THEN 'PROCESSO'
        WHEN GRUPO_PERICIA_DESC = 'RETIFICAÇÃO' AND TIPO_ATENDIMENTO = 'ATENDIMENTO' THEN 'PROCESSO'
        WHEN GRUPO_PERICIA_DESC = 'RETIFICAÇÃO DE ARTIGO' AND TIPO_ATENDIMENTO IS NULL THEN 'PROCESSO'
        WHEN GRUPO_PERICIA_DESC = 'REVERSÃO APOSENTADORIA - RAP' AND TIPO_ATENDIMENTO = 'JUNTA' THEN 'JUNTA MÉDICA'
        WHEN GRUPO_PERICIA_DESC = 'REVERSÃO APOSENTADORIA - RAP' AND TIPO_ATENDIMENTO = 'JUNTA' THEN 'JUNTA MÉDICA'
        WHEN GRUPO_PERICIA_DESC = 'SALÁRIO FAMÍLIA TRÍPLICE - SFT' AND TIPO_ATENDIMENTO = 'PROCESSO' THEN 'PROCESSO'
        WHEN GRUPO_PERICIA_DESC = 'SALÁRIO FAMÍLIA TRÍPLICE - SFT' AND TIPO_ATENDIMENTO = 'JUNTA' THEN 'JUNTA MÉDICA'
        WHEN GRUPO_PERICIA_DESC = 'SALÁRIO FAMÍLIA TRÍPLICE - SFT' AND TIPO_ATENDIMENTO = 'JUNTA' THEN 'JUNTA MÉDICA'
        WHEN GRUPO_PERICIA_DESC = 'SALÁRIO FAMÍLIA TRÍPLICE - SFT' AND TIPO_ATENDIMENTO = 'PROCESSO' THEN 'PROCESSO'
        WHEN GRUPO_PERICIA_DESC = 'SERVIÇO SOCIAL - SESO' AND TIPO_ATENDIMENTO = 'ATENDIMENTO' THEN 'ATENDIMENTO MÉDICO'
        ELSE 'VERIFICAR'
        END TIPO_ATENDIMENTO_PADRAO
FROM ${ref("BPT_etp03_joincargo_tmp")}