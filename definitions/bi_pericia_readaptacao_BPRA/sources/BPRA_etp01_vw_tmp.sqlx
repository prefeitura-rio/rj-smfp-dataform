      WHEN DECISAO_PERITOJUNTA = 'INDEF CANC DA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'INDEF RD POR LTS' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'PARECER FAVORAVEL' AND SIGLA = 'ATEND FONO JRD' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'DEVOLVIDO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'DEVOLVIDO P CIÊNCIA' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'REVISAO JRD' AND SIGLA = 'JUNTA READAP' THEN 'REAVALIAR'
      WHEN DECISAO_PERITOJUNTA = 'DEFERIDO O CANC' AND SIGLA = 'JUNTA CANC RD' THEN 'CANCELAMENTO DE READAPTACAO DEFERIDO'
      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDO O CANC' AND SIGLA = 'JUNTA CANC RD' THEN 'CANCELAMENTO DE READAPTACAO INDEFERIDO'
      WHEN DECISAO_PERITOJUNTA = 'DEVOLVIDO EXIG' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'RD POR >10 ANOS' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDA REVISÃO' AND SIGLA = 'REVISÃO DE TERMOS' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'MANTER OS TERMOS' AND SIGLA = 'REVISÃO DE TERMOS' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA IS NULL THEN 'OUTROS ATENDIMENTOS'
      ELSE 'VERIFICAR'
   END RESULTADO_AGRUP_PERITOS
   ,
   CASE
      WHEN DECISAO_PERITOJUNTA = 'DEFERIDA' AND SIGLA = 'REVISÃO DE ATRIBUICOES' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'DEFERIDO O PLEITO' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'ADMINISTRATIVO'
