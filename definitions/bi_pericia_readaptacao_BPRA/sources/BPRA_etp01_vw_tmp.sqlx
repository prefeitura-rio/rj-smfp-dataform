      WHEN DECISAO_PERITOJUNTA = 'DEF ALT DE TERMOS' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'DEF CANC DA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'DEF ITPR' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
