      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDO O PLEITO' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDO O PLEITO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'CONVOCAÇÃO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'ADMINISTRATIVO'
