      WHEN DECISAO_PERITOJUNTA = 'JCRD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'READAPTACAO DEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'RD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'READAPTACAO DEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'INDEF ITPR' AND SIGLA = 'JUNTA ITPR' THEN 'READAPTACAO INDEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDO' AND SIGLA = 'JUNTA READAP EX OF' THEN 'READAPTACAO INDEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'JCRD INDEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'READAPTACAO INDEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'RD INDEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'READAPTACAO INDEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'MANTER LTS' AND SIGLA = 'JUNTA READAP EX OF' THEN 'READAPTACAO INDEFERIDA PARA MANTER LICENCA MEDICA'
      WHEN DECISAO_PERITOJUNTA = 'DEVOLVIDO' AND SIGLA = 'JUNTA READAP' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PERITOJUNTA = 'EM EXIGÊNCIA' AND SIGLA = 'JUNTA READAP' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PERITOJUNTA = 'EM EXIGENCIA' AND SIGLA = 'JUNTA READAP' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PERITOJUNTA = 'EM EXIGENCIA' AND SIGLA = 'JUNTA READAP EX OF' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PERITOJUNTA = 'ALTA DA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'DEF ALT DE TERMOS' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'DEF CANC DA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'DEF ITPR' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'DEFERIDA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'INDEF CANC DA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'INDEF RD POR LTS' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'PARECER FAVORAVEL' AND SIGLA = 'ATEND FONO JRD' THEN 'PARECER DO PERITO ESPECIALISTA'
      WHEN DECISAO_PERITOJUNTA = 'DEVOLVIDO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'DEVOLVIDO P CIÊNCIA' AND SIGLA = 'RESP. EM PROCESSO' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'REVISAO JRD' AND SIGLA = 'JUNTA READAP' THEN 'NECESSIDADE DE REAVALIAÇÃO DA JUNTA MEDICA'
      WHEN DECISAO_PERITOJUNTA = 'DEFERIDO O CANC' AND SIGLA = 'JUNTA CANC RD' THEN 'CANCELAMENTO DE READAPTACAO DEFERIDO'
      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDO O CANC' AND SIGLA = 'JUNTA CANC RD' THEN 'CANCELAMENTO DE READAPTACAO INDEFERIDO'
      WHEN DECISAO_PERITOJUNTA = 'DEVOLVIDO EXIG' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PERITOJUNTA = 'RD POR >10 ANOS' AND SIGLA = 'RESP. EM PROCESSO' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDA REVISÃO' AND SIGLA = 'REVISÃO DE TERMOS' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA = 'MANTER OS TERMOS' AND SIGLA = 'REVISÃO DE TERMOS' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PERITOJUNTA IS NULL THEN 'ATENDIMENTO SEM DECISAO'
      ELSE 'VERIFICAR'
   END RESULTADO_PADRAO_PERITOS
FROM ${ref("bi_pericia_readaptacao_original_2")}
