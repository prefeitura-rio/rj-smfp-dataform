config {
    type: "view",
    name: "BPRA_etp01_vw_tmp",
    description: ""
}

SELECT *,
   CASE
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO O PLEITO' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO O PLEITO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDA' AND SIGLA = 'REVISÃO DE ATRIBUICOES' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO O PLEITO' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO O PLEITO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDA' AND SIGLA = 'REVISÃO DE ATRIBUICOES' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'CONVOCAR' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'CONVOCAÇÃO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'EM ANALISE' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'RESPONDIDO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEVOLVIDO O PROCESSO' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEVOLVIDO COM EXIG.' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'EXIGÊNCIAS' AND SIGLA = 'REVISÃO DE ATRIBUICOES' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'ALTA DE RD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'CANC RD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'PEDIDO DE CANCELAMENTO DE READAPTACAO DEFERIDO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'JCRD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'PEDIDO DE CANCELAMENTO DE READAPTACAO DEFERIDO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'CANC RD INDEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'PEDIDO DE CANCELAMENTO DE READAPTACAO INDEFERIDO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'JCRD INDEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'PEDIDO DE CANCELAMENTO DE READAPTACAO INDEFERIDO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEF ITPR' AND SIGLA = 'JUNTA ITPR' THEN 'DEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'ITPR' AND SIGLA = 'JUNTA READAP' THEN 'DEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'RD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'DEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO' AND SIGLA = 'JUNTA READAP' THEN 'DEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEF ITPR' AND SIGLA = 'JUNTA ITPR' THEN 'INDEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'RD INDEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'INDEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEVOLVIDO' AND SIGLA = 'JUNTA READAP' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'EM EXIGENCIA' AND SIGLA = 'JUNTA READAP' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'EM EXIGÊNCIA' AND SIGLA = 'JUNTA READAP' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO' AND SIGLA = 'JUNTA READAP EX OF' THEN 'DEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO' AND SIGLA = 'JUNTA READAP EX OF' THEN 'INDEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'MANTER LTS' AND SIGLA = 'JUNTA READAP EX OF' THEN 'INDEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'EM EXIGENCIA' AND SIGLA = 'JUNTA READAP EX OF' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'ALTA DA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEF ALT DE TERMOS' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEF CANC DA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEF ITPR' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEF CANC DA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEF RD POR LTS' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'PARECER FAVORAVEL' AND SIGLA = 'ATEND FONO JRD' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'REVISAO JRD' AND SIGLA = 'JUNTA READAP' THEN 'REAVALIAR'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'RD >10 ANOS' AND SIGLA = 'JUNTA READAP' THEN 'DEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO O CANC' AND SIGLA = 'JUNTA CANC RD' THEN 'PEDIDO DE CANCELAMENTO DE READAPTACAO DEFERIDO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO O CANC' AND SIGLA = 'JUNTA CANC RD' THEN 'PEDIDO DE CANCELAMENTO DE READAPTACAO INDEFERIDO'
      WHEN ID_JUNTA IS NULL THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PHOMOLOGADOR_CODIGO IS NULL THEN 'JUNTA SEM HOMOLOGACAO'
      ELSE 'VERIFICAR'
   END RESULTADO_AGRUP_PHOMOLOG
,
   CASE
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO O PLEITO' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO O PLEITO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDA' AND SIGLA = 'REVISÃO DE ATRIBUICOES' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO O PLEITO' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO O PLEITO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDA' AND SIGLA = 'REVISÃO DE ATRIBUICOES' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'CONVOCAR' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'CONVOCAÇÃO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'EM ANALISE' AND SIGLA = 'RESP. EM PROCESSO' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'RESPONDIDO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEVOLVIDO O PROCESSO' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEVOLVIDO COM EXIG.' AND SIGLA = 'RESP. EM PROCESSO' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'EXIGÊNCIAS' AND SIGLA = 'REVISÃO DE ATRIBUICOES' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'ALTA DE RD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'CANC RD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'DEFERIDO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'JCRD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'DEFERIDO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'CANC RD INDEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'INDEFERIDO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'JCRD INDEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'INDEFERIDO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEF ITPR' AND SIGLA = 'JUNTA ITPR' THEN 'READAPTACAO DEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'ITPR' AND SIGLA = 'JUNTA READAP' THEN 'READAPTACAO DEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'RD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'READAPTACAO DEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO' AND SIGLA = 'JUNTA READAP' THEN 'READAPTACAO DEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEF ITPR' AND SIGLA = 'JUNTA ITPR' THEN 'READAPTACAO INDEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'RD INDEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'READAPTACAO INDEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEVOLVIDO' AND SIGLA = 'JUNTA READAP' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'EM EXIGENCIA' AND SIGLA = 'JUNTA READAP' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'EM EXIGÊNCIA' AND SIGLA = 'JUNTA READAP' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO' AND SIGLA = 'JUNTA READAP EX OF' THEN 'READAPTACAO DEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO' AND SIGLA = 'JUNTA READAP EX OF' THEN 'READAPTACAO INDEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'MANTER LTS' AND SIGLA = 'JUNTA READAP EX OF' THEN 'READAPTACAO INDEFERIDA PARA MANTER LICENCA MEDICA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'EM EXIGENCIA' AND SIGLA = 'JUNTA READAP EX OF' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'ALTA DA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEF ALT DE TERMOS' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEF CANC DA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEF ITPR' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEF CANC DA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEF RD POR LTS' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDA RD' AND SIGLA = 'CONCLUSAO DE JUNTA' THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'PARECER FAVORAVEL' AND SIGLA = 'ATEND FONO JRD' THEN 'PARECER DO PERITO ESPECIALISTA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'REVISAO JRD' AND SIGLA = 'JUNTA READAP' THEN 'NECESSIDADE DE REAVALIAÇÃO DA JUNTA MEDICA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'RD >10 ANOS' AND SIGLA = 'JUNTA READAP' THEN 'READAPTACAO DEFERIDA'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO O CANC' AND SIGLA = 'JUNTA CANC RD' THEN 'DEFERIDO'
      WHEN DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO O CANC' AND SIGLA = 'JUNTA CANC RD' THEN 'INDEFERIDO'
      WHEN ID_JUNTA IS NULL THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_CODIGO IS NULL THEN 'JUNTA SEM HOMOLOGACAO'
      ELSE 'VERIFICAR'
   END RESULTADO_PADRAO_PHOMOLOG
,
   CASE
      WHEN DECISAO_PERITOJUNTA = 'DEFERIDA' AND SIGLA = 'REVISÃO DE ATRIBUICOES' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'DEFERIDO O PLEITO' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'DEFERIDO O PLEITO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDA' AND SIGLA = 'REVISÃO DE ATRIBUICOES' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDO O PLEITO' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDO O PLEITO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'CONVOCAÇÃO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'CONVOCAR' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'EM ANÁLISE' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'RESPONDIDO' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'DEVOLVIDO COM EXIG.' AND SIGLA = 'RESP. EM PROCESSO' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'DEVOLVIDO O PROCESSO' AND SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'EXIGÊNCIAS' AND SIGLA = 'REVISÃO DE ATRIBUICOES' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'ALTA DE RD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'CANC RD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'CANCELAMENTO DE READAPTACAO DEFERIDO'
      WHEN DECISAO_PERITOJUNTA = 'CANC RD INDEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'CANCELAMENTO DE READAPTACAO INDEFERIDO'
      WHEN DECISAO_PERITOJUNTA = 'DEF ITPR' AND SIGLA = 'JUNTA ITPR' THEN 'DEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'DEFERIDO' AND SIGLA = 'JUNTA READAP EX OF' THEN 'DEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'ITPR' AND SIGLA = 'JUNTA READAP' THEN 'DEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'JCRD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'DEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'RD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'DEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'INDEF ITPR' AND SIGLA = 'JUNTA ITPR' THEN 'INDEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'INDEFERIDO' AND SIGLA = 'JUNTA READAP EX OF' THEN 'INDEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'JCRD INDEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'INDEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'RD INDEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'INDEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'MANTER LTS' AND SIGLA = 'JUNTA READAP EX OF' THEN 'INDEFERIDA'
      WHEN DECISAO_PERITOJUNTA = 'DEVOLVIDO' AND SIGLA = 'JUNTA READAP' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'EM EXIGÊNCIA' AND SIGLA = 'JUNTA READAP' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'EM EXIGENCIA' AND SIGLA = 'JUNTA READAP' THEN 'OUTROS ATENDIMENTOS'
      WHEN DECISAO_PERITOJUNTA = 'EM EXIGENCIA' AND SIGLA = 'JUNTA READAP EX OF' THEN 'OUTROS ATENDIMENTOS'
