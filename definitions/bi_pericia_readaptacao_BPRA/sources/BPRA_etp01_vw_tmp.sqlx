      WHEN DECISAO_PERITOJUNTA = 'EXIGÊNCIAS' AND SIGLA = 'REVISÃO DE ATRIBUICOES' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN DECISAO_PERITOJUNTA = 'ALTA DE RD DEFERIDA' AND SIGLA = 'JUNTA READAP' THEN 'ADMINISTRATIVO'
