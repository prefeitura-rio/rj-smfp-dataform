config {
    type: "view",
    name: "BPRA_etp02_vw_tmp",
    description: ""
}

SELECT *,
       CASE
          WHEN SIGLA = 'AVALIAÇÃO DE ITPR' THEN 'PROCESSUAL'
          WHEN SIGLA = 'RESP. EM PROCESSO' THEN 'PROCESSUAL'
          WHEN SIGLA = 'REVISÃO DE ATRIBUICOES' THEN 'PROCESSUAL'
          WHEN SIGLA = 'REVISÃO DE TERMOS' THEN 'PROCESSUAL'
          WHEN SIGLA = 'JUNTA READAP' THEN 'PROCESSUAL'
          WHEN SIGLA = 'JUNTA ITPR' THEN 'PROCESSUAL'
          WHEN SIGLA = 'JUNTA CANC RD' THEN 'PROCESSUAL'
          WHEN SIGLA = 'JUNTA READAP EX OF' THEN 'ENCAMINHADO A PARTIR DE LICENCA MEDICA'
          WHEN SIGLA = 'CONCLUSAO DE JUNTA' THEN 'NA'
          WHEN SIGLA = 'ATEND FONO JRD' THEN 'NA'
          ELSE 'VERIFICAR'
       END ORIGEM
FROM ${ref("BPRA_etp01_vw_tmp")}