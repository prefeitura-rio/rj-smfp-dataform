config {
  type: "operations"
  , description: "Ajustes nos registros de setor que apresentam NULL na secretaria"
}
-- Correção das inconsistências do autorrelacionamento da tabela SETOR, onde existem setor e secretaria

/*
  Neste ponto, buscamos os registros da tabela aux_setor_n01 que não encontraram uma secretaria no autorrelacionamento no momento
  da criação de aux_setor_secretaria_n02. Esses registros são inseridos na tabela aux_secretaria_n01 como sendo secretarias de si
  mesmos, para que não fiquem órfãos. O campo 'calculada' é atualizado para TRUE, informando que os registros foram inseridos de
  forma 'forçada'. Isso pode servir para controlar o crescimento desse problema.
 */

INSERT INTO ${ref("aux_SES_secretaria_n01")} 
  (setor, codigo, sigla, emp_codigo, nome, inicio, fim_aux, fim, calculada)
SELECT 
  coalesce(orig.codigo_secretaria, orig.setor)
  , coalesce(orig.codigo_secretaria, orig.setor)
  , coalesce(orig.sigla, orig.nome)
  , orig.emp_codigo
  , orig.nome
  , orig.inicio
  , orig.fim_aux
  , orig.fim
  , TRUE
  FROM  ${ref("aux_setor_secretaria_n02")} sec
    JOIN  ${ref("aux_SES_setor_n01")} orig ON 
      sec.id_aux = orig.id_aux
  WHERE sec_sigla IS NULL;

/*
  Neste ponto, os mesmos registros órfãos são identificados na tabela aux_setor_secretaria_n02 e atualizados com os valores de
  sec_codigo e sec_sigla para os próprios valores dos registros dos setores, eliminando assim todos os valores nulos no 
  autorrelacionamento. O campo sec_reconhecida é atualizado para FALSE, informando que essa secretaria não foi reconhecida
  de forma natural, havendo uma intervenção.
 */

UPDATE 
      ${ref("aux_setor_secretaria_n02")} stor 
  SET 
    stor.sec_codigo = coalesce(subq.codigo_secretaria, subq.setor)
    , stor.setor = coalesce(subq.codigo_secretaria, subq.setor) 
    , stor.sec_sigla = COALESCE(subq.sigla, subq.nome)
    , stor.sec_reconhecida = FALSE
  from
    ( SELECT orig.id_aux , orig.codigo_secretaria, orig.sigla, orig.nome, orig.setor
      FROM  ${ref("aux_setor_secretaria_n02")} sec
      JOIN  ${ref("aux_SES_setor_n01")} orig ON 
        sec.id_aux = orig.id_aux
      WHERE sec_sigla IS NULL
     ) subq      
  WHERE
    stor.id_aux = subq.id_aux