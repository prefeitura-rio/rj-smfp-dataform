config {
    type: "view",
    tags: ["BPLO"],
    name: "BPLO_etp03_vw_tmp",
    description: "Agrupa e identifica períodos contínuos de licenças médicas por matrícula, acumulando a duração total de afastamentos válidos e atribuindo identificadores únicos a cada sequência de licença com base em regras de continuidade, tipo de perícia e resultado anterior"
}

WITH CTE1 AS (
    SELECT 
        MATRICULA,
        NUMFUNC,
        NUMVINC,
        DTPOSSE,
        EMP_CODIGO,
        SEXO,
        IDADE,
        NOME,
        SIGLA,
        GRUPO_CID,
        DTINI,
        DTFIM,
        FAIXA_TEMPO,
        DTFIM_ANTERIOR,
        PERITO,
        NEGADO,
        DTATEND,
        TIPO_PERICIA,
        DESC_TIPO_PERICIA_DETALHADO,
        TIPO_ATENDIMENTO,
        RESULTADO,
        DESCRICAO_RESULTADO,
        LAG(RESULTADO) OVER (ORDER BY MATRICULA, DTINI ASC) AS RESULTADO_ANTERIOR
    FROM ${ref("BPLO_etp02_vw_tmp")}
),
CTE2 AS (
    SELECT
        MATRICULA,
        NUMFUNC,
        NUMVINC,
        DTPOSSE,
        EMP_CODIGO,
        SEXO,
        IDADE,
        NOME,
        SIGLA,
        GRUPO_CID,
        DTINI,
        DTFIM,
        FAIXA_TEMPO,
        DTFIM_ANTERIOR,
        PERITO,
        NEGADO,
        DTATEND,
        TIPO_PERICIA,
        DESC_TIPO_PERICIA_DETALHADO,
        TIPO_ATENDIMENTO,
        RESULTADO,
        DESCRICAO_RESULTADO,
        RESULTADO_ANTERIOR,
        CASE
            WHEN MATRICULA = LAG(MATRICULA) OVER (ORDER BY MATRICULA, DTINI ASC) AND DTINI <= DATE_ADD(CAST(DTFIM_ANTERIOR AS DATE), INTERVAL 1 day)
                AND TIPO_PERICIA = LAG(TIPO_PERICIA)  OVER (ORDER BY MATRICULA, DTINI ASC)    
                AND RESULTADO_ANTERIOR != 'NEGADA' 
                THEN SUM(FAIXA_TEMPO) OVER (PARTITION BY MATRICULA ORDER BY DTINI)
            WHEN DTFIM_ANTERIOR IS NULL THEN FAIXA_TEMPO
            ELSE FAIXA_TEMPO 
        END AS FAIXA_ACUMULADA
FROM CTE1
),
CTE3 AS (
    select
        MATRICULA, NUMFUNC, EMP_CODIGO, SIGLA, NUMVINC, DTINI, GRUPO_CID, DTFIM, SEXO, DTPOSSE, FAIXA_TEMPO, DTFIM_ANTERIOR, FAIXA_ACUMULADA, NOME, IDADE, PERITO,
        DTATEND, TIPO_PERICIA, DESC_TIPO_PERICIA_DETALHADO, TIPO_ATENDIMENTO, RESULTADO, DESCRICAO_RESULTADO, RESULTADO_ANTERIOR,
        NEGADO, DENSE_RANK() OVER (PARTITION BY MATRICULA ORDER BY FAIXA_ACUMULADA) AS Identificador_Licenca
from CTE2
),
CTE4 AS (
    SELECT 
        MATRICULA, NUMFUNC, NUMVINC, EMP_CODIGO, SIGLA, GRUPO_CID, DTINI, SEXO, DTPOSSE, DTFIM, FAIXA_TEMPO, DTFIM_ANTERIOR, FAIXA_ACUMULADA, RESULTADO_ANTERIOR,
        DTATEND, TIPO_PERICIA, DESC_TIPO_PERICIA_DETALHADO, TIPO_ATENDIMENTO, RESULTADO, DESCRICAO_RESULTADO,
        SUM(Flag_Nova_Matricula) OVER (PARTITION BY MATRICULA ORDER BY DTINI ASC) AS Identificador_Licenca,
        NOME, NEGADO, PERITO, IDADE
  FROM (
    SELECT 
        MATRICULA, NUMFUNC, NUMVINC, EMP_CODIGO, DTINI, GRUPO_CID, DTFIM, SIGLA, SEXO, DTPOSSE, FAIXA_TEMPO, DTFIM_ANTERIOR, FAIXA_ACUMULADA, NOME, IDADE, NEGADO, PERITO,
        DTATEND, TIPO_PERICIA, DESC_TIPO_PERICIA_DETALHADO, TIPO_ATENDIMENTO, RESULTADO, DESCRICAO_RESULTADO, RESULTADO_ANTERIOR,
        CASE
              WHEN MATRICULA = LAG(MATRICULA) OVER (ORDER BY MATRICULA, DTINI ASC)  --and GRUPO_CID = LAG(GRUPO_CID) OVER (ORDER BY MATRICULA, DTINI ASC)  
                  AND TIPO_PERICIA = LAG(TIPO_PERICIA) OVER (ORDER BY MATRICULA, DTINI ASC)
                  AND RESULTADO_ANTERIOR != 'NEGADA' 
                  AND DTINI <= DATE_ADD(CAST(DTFIM_ANTERIOR AS DATE), INTERVAL 1 day) THEN 0
              ELSE 1
        END AS Flag_Nova_Matricula 
FROM CTE3
) CTE5_Flag
)

    SELECT 
        MATRICULA, NUMFUNC, SIGLA, EMP_CODIGO, NUMVINC, GRUPO_CID, DTINI, SEXO, DTFIM, DTPOSSE, FAIXA_TEMPO, DTFIM_ANTERIOR, RESULTADO_ANTERIOR,
        Identificador_Licenca,
        NOME, IDADE, NEGADO, PERITO, DTATEND, TIPO_PERICIA, DESC_TIPO_PERICIA_DETALHADO, TIPO_ATENDIMENTO, RESULTADO, DESCRICAO_RESULTADO,
        CASE
           WHEN MATRICULA = LAG(MATRICULA) OVER (ORDER BY MATRICULA, DTINI ASC)
               AND DTINI <= DATE_ADD(CAST(DTFIM_ANTERIOR AS DATE), INTERVAL 1 DAY)
               AND TIPO_PERICIA = LAG(TIPO_PERICIA)  OVER (ORDER BY MATRICULA, DTINI ASC)
               AND RESULTADO_ANTERIOR != 'NEGADA' 
               THEN SUM(FAIXA_TEMPO) OVER (PARTITION BY MATRICULA,IDENTIFICADOR_LICENCA  ORDER BY DTINI)
               --THEN FAIXA_TEMPO + LAG(FAIXA_ACUMULADA) OVER (PARTITION BY MATRICULA, IDENTIFICADOR_LICENCA ORDER BY DTINI ASC )
           WHEN DTFIM_ANTERIOR IS NULL THEN FAIXA_TEMPO
           ELSE FAIXA_TEMPO
        END AS faixa_CERTA
from CTE4
ORDER BY MATRICULA, DTINI ASC