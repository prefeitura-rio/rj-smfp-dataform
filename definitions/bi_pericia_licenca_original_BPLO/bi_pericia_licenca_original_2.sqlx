config {
    type: "table"
    , name: "bi_pericia_licenca_original_2"
    , tags: ["EXEC", "BPLO"]
    , dependencies: ["BPLO_backup_nxx", "BPLO_etp05_vw_tmp"]
    , description: ""
}

SELECT
    MATRICULA,
    cast(NUMFUNC AS INT64) AS NUMFUNC,
    cast(NUMVINC AS INT64) AS NUMVINC,
    cast(DTPOSSE AS STRING) AS DTPOSSE,
    DTVAC, -- SE TIVER DANDO ERRO, TRANSFORMAR PARA FLOAT64
    SEXO,
    cast(IDADE AS INT64) AS IDADE,
    CARGO,
    cast(EMP_CODIGO AS INTEGER) AS EMP_CODIGO,
    ORGAO,
    cast(DTINI_LOTACAO AS STRING) AS DTINI_LOTACAO,
    cast(DTFIM_LOTACAO AS STRING) AS DTFIM_LOTACAO,
    CAST(ROUND(VALOR, 2) AS FLOAT64) as VALOR,
    TIPO_ATENDIMENTO,
    SIGLA,
    TIPO_PERICIA,
    DESC_TIPO_PERICIA_DETALHADO,
    PERITO,
    NEGADO,
    REPLACE(GRUPO_CID, ',', ';') as GRUPO_CID,
    cast(DTATEND AS STRING) AS DTATEND,
    cast(DTINI AS STRING) AS DTINI,
    cast(DTFIM AS STRING) AS DTFIM,
    IDENTIFICADOR_LICENCA,
    CAST(round(IDAS_PERICIA_MESMA_LICENCA,0) AS INTEGER) as IDAS_PERICIA_MESMA_LICENCA,
    CAST(round(FAIXA_ACUMULADA_MESMA_LICENCA,0) AS FLOAT64) as FAIXA_ACUMULADA_MESMA_LICENCA,
    RESULTADO,
    DESCRICAO_RESULTADO
FROM
    ${ref("BPLO_etp05_vw_tmp")}