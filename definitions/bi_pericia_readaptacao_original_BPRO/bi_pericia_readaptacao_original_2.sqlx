config {
    type: "table"
    , name: "bi_pericia_readaptacao_original_2"
    , tags: ["EXEC", "BPRO"]
    , dependencies: ["BPRO_backup_nxx"]
    , description: ""
}

SELECT
    CAST(CHAVEPRONT AS INT64) AS CHAVEPRONT
    , CAST(ID_JUNTA AS INT64) AS ID_JUNTA
    , CAST(NUMFUNC AS INT64) AS NUMFUNC
    , MATRICULA
    , NOMESERVIDOR
    , CAST(SUBSTR(DTATEND, 0, 10) AS DATE) AS DTATEND
    , CAST(SUBSTR(DTCONCLUSAO_JUNTA, 0, 10) AS DATE) AS DTCONCLUSAO_JUNTA
    , CAST(SUBSTR(DTCONCLUSAO_HOMOLOGACAO, 0, 10) AS DATE) AS DTCONCLUSAO_HOMOLOGACAO
    , COD_CID1
    , COD_CID2
    , COD_CID3
    , TIPO_ATENDIMENTO
    , CAST(GRUPO_PERICIA_CODIGO AS INT64) AS GRUPO_PERICIA_CODIGO
    , GRUPO_PERICIA_DESC
    , SIGLA
    , SIGLA_DESC
    , CAST(DECISAO_PERITOJUNTA_CODIGO AS INT64) AS DECISAO_PERITOJUNTA_CODIGO
    , DECISAO_PERITOJUNTA
    , DECISAO_PERITOJUNTA_DESC
    , CAST(DECISAO_PHOMOLOGADOR_CODIGO AS INT64) AS DECISAO_PHOMOLOGADOR_CODIGO
    , DECISAO_PHOMOLOGADOR_RESULT
    , DECISAO_PHOMOLOGADOR_DESC
    , PERITO_HOMOLOGADOR_CRM
    , PERITO_HOMOLOGADOR_NOME
    , DTPOSSE
    , DTVAC
    , CAST(EMP_CODIGO AS INT64) AS EMP_CODIGO
    , SEXO
    , CAST(IDADE AS INT64) AS IDADE
    , ORGAO
    , DTINI_LOTACAO
    , DTFIM_LOTACAO
    , GRUPAMENTO_CID
    , CRM
    , CAST(TEMPO_READ AS INT64) AS TEMPO_READ
    , CAST(MIN(DTATEND) AS DATE) AS MIN_DTATEND_
FROM ${ref("BPRO_etp03_readaptacao_vw_tmp")}
GROUP BY
    CAST(CHAVEPRONT AS INT64)
    , CAST(ID_JUNTA AS INT64)
    , CAST(NUMFUNC AS INT64)
    , MATRICULA
    , NOMESERVIDOR
    , CAST(SUBSTR(DTATEND, 0, 10) AS DATE)
    , CAST(SUBSTR(DTCONCLUSAO_JUNTA, 0, 10) AS DATE)
    , CAST(SUBSTR(DTCONCLUSAO_HOMOLOGACAO, 0, 10) AS DATE)
    , COD_CID1
    , COD_CID2
    , COD_CID3
    , TIPO_ATENDIMENTO
    , CAST(GRUPO_PERICIA_CODIGO AS INT64)
    , GRUPO_PERICIA_DESC
    , SIGLA
    , SIGLA_DESC
    , CAST(DECISAO_PERITOJUNTA_CODIGO AS INT64)
    , DECISAO_PERITOJUNTA
    , DECISAO_PERITOJUNTA_DESC
    , CAST(DECISAO_PHOMOLOGADOR_CODIGO AS INT64)
    , DECISAO_PHOMOLOGADOR_RESULT
    , DECISAO_PHOMOLOGADOR_DESC
    , PERITO_HOMOLOGADOR_CRM
    , PERITO_HOMOLOGADOR_NOME
    , DTPOSSE
    , DTVAC
    , EMP_CODIGO
    , SEXO
    , IDADE
    , ORGAO
    , DTINI_LOTACAO
    , DTFIM_LOTACAO
    , GRUPAMENTO_CID
    , CRM
    , CAST(TEMPO_READ AS INT64)
