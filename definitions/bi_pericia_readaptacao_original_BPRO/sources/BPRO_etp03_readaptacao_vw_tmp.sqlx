config {
    type: "view",
    name: "BPRO_etp03_readaptacao_vw_tmp",
    description: ""
}

SELECT
    DISTINCT
    REPLACE(CHAVEPRONT, ',', ' ') AS CHAVEPRONT,
    REPLACE(ID_JUNTA, ',', ' ') AS ID_JUNTA,
    REPLACE(NUMFUNC, ',', ' ') AS NUMFUNC,
    REPLACE(MATRICULA, ',', ' ') AS MATRICULA,
    REPLACE(NOMESERVIDOR, ',', ' ') AS NOMESERVIDOR,
    REPLACE(DTATEND, ',', ' ') AS DTATEND,
    REPLACE(DTCONCLUSAO_JUNTA, ',', ' ') AS DTCONCLUSAO_JUNTA,
    REPLACE(DTCONCLUSAO_HOMOLOGACAO, ',', ' ') AS DTCONCLUSAO_HOMOLOGACAO,
    REPLACE(cod_cid1, ',', ' ') AS cod_cid1,
    REPLACE(COD_CID2, ',', ' ') AS COD_CID2,
    REPLACE(COD_CID3, ',', ' ') AS COD_CID3,
    REPLACE(TIPO_ATENDIMENTO, ',', ' ') AS TIPO_ATENDIMENTO,
    REPLACE(GRUPO_PERICIA_CODIGO, ',', ' ') AS GRUPO_PERICIA_CODIGO,
    REPLACE(GRUPO_PERICIA_DESC, ',', ' ') AS GRUPO_PERICIA_DESC,
    REPLACE(SIGLA, ',', ' ') AS SIGLA,
    REPLACE(SIGLA_DESC, ',', ' ') AS SIGLA_DESC,
    REPLACE(DECISAO_PERITOJUNTA_CODIGO, ',', ' ') AS DECISAO_PERITOJUNTA_CODIGO,
    REPLACE(DECISAO_PERITOJUNTA, ',', ' ') AS DECISAO_PERITOJUNTA,
    REPLACE(DECISAO_PERITOJUNTA_DESC, ',', ' ') AS DECISAO_PERITOJUNTA_DESC,
    REPLACE(DECISAO_PHOMOLOGADOR_CODIGO, ',', ' ') AS DECISAO_PHOMOLOGADOR_CODIGO,
    REPLACE(DECISAO_PHOMOLOGADOR_RESULT, ',', ' ') AS DECISAO_PHOMOLOGADOR_RESULT,
    REPLACE(DECISAO_PHOMOLOGADOR_DESC, ',', ' ') AS DECISAO_PHOMOLOGADOR_DESC,
    REPLACE(PERITO_HOMOLOGADOR_CRM, ',', ' ') AS PERITO_HOMOLOGADOR_CRM,
    REPLACE(PERITO_HOMOLOGADOR_NOME, ',', ' ') AS PERITO_HOMOLOGADOR_NOME,
    DTPOSSE AS DTPOSSE,
    DTVAC AS DTVAC,
    REPLACE(EMP_CODIGO, ',', ' ') AS EMP_CODIGO,
    REPLACE(sexo, ',', ' ') AS sexo,
    IDADE AS IDADE,
    REPLACE(ORGAO, ',', ' ') AS ORGAO,
    DTINI_LOTACAO AS DTINI_LOTACAO,
    DTFIM_LOTACAO AS DTFIM_LOTACAO,
    REPLACE(GRUPAMENTO_CID, ',', ' ') AS GRUPAMENTO_CID,
    CRM,
    TEMPO_READ
   
FROM ${ref("BPRO_etp02_readaptacao_vw_tmp")}
GROUP BY
        CHAVEPRONT,
        ID_JUNTA,
        NUMFUNC,
        MATRICULA,
        NOMESERVIDOR,
        DTATEND, --ERGON.PRONTUARIO --ATENCAO! essa variavel faz duplicar
        DTCONCLUSAO_JUNTA, --ERGON.PRONTUARIO --ATENCAO! essa variavel faz duplicar
        DTCONCLUSAO_HOMOLOGACAO,
        cod_cid1,
        COD_CID2,
        COD_CID3,
        TIPO_ATENDIMENTO, --bi_pericia_geral=GRUPO2
        GRUPO_PERICIA_CODIGO, --ERGON.EXAMES e ERGON.ERG_PM_GRUPOEXAME (igual nas duas)
        GRUPO_PERICIA_DESC, --ERGON.ERG_PM_GRUPOEXAME variavel NOME (eh o que chamamos de GRUPO_PERICIA no codigo de licenca)
        SIGLA, --ERGON.EXAME igual a SIGLA da ERGON.PRONTUARIO e igual a SIGLAEXAME da ERGON.DECISAO
        SIGLA_DESC, --ERGON.EXAME variavel chama NOME e eh a descricao da SIGLA (ERGON.PRONTUARIO, ERGON.DECISAO e ERGON.EXAME)
        DECISAO_PERITOJUNTA_CODIGO, --ERGON.PRONTUARIO (eh um codigo cuja descricao se encontra na tabela ERGON.DECISAO, nas variaveis SIGLA e DESCRICAO)
        DECISAO_PERITOJUNTA, --ERGON.DECISAO chamamos de RESULTADO no codigo de licenca
        DECISAO_PERITOJUNTA_DESC, --ERGON.DECISAO descricao da SIGLA_DECISAO
        DECISAO_PHOMOLOGADOR_CODIGO,
        DECISAO_PHOMOLOGADOR_RESULT,
        DECISAO_PHOMOLOGADOR_DESC,
        -- PHOMOLOGADOR_JUSTIFICATIVA,
        PERITO_HOMOLOGADOR_CRM, --se for necessario tem tambem ID_RESULTJUNTA
        PERITO_HOMOLOGADOR_NOME,
        DTPOSSE,
        DTVAC,
        EMP_CODIGO,
        sexo,
        IDADE,
        ORGAO,
        DTINI_LOTACAO,
        DTFIM_LOTACAO,
        GRUPAMENTO_CID,
        CRM,
        TEMPO_READ
ORDER BY MATRICULA, NUMFUNC, DTATEND

