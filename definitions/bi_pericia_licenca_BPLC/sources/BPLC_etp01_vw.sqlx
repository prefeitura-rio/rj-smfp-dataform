      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF OUTROS INI' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF PA PARA IA' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF PARECER PRORR' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF PER LTS C ALTA' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF PERIODO LTS IA' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF PERIODO LTS IN' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF PERIODO LTS PR' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'ALTA' THEN 'PARECER DA JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'DEFERIDO' THEN 'PARECER DA JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'EXCL OUTROS' THEN 'PARECER DA JUNTA MEDICA'
