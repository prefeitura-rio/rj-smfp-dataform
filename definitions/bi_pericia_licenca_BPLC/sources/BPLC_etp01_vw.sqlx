      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF ART 99 P 88 I' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF ART 99 P 88 IA' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF ART 99 P100 IA' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF ART 99 PA' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF EXC 177X' THEN 'ADMINISTRATIVO'
