      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RET 99 PARA 88 PR' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF 88 IA P 100 IA' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF 99 PA PARA PA' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'RETIF ALTA ADMIN' THEN 'ADMINISTRATIVO'
