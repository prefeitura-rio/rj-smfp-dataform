      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'NEGADA' THEN 'PARECER DA JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'NEGADA ART.100' THEN 'PARECER DA JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'NEGADA ART.88' THEN 'PARECER DA JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'NEGADA ART.99' THEN 'PARECER DA JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'PRORROGACAO' THEN 'PARECER DA JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'PRORROGAÇÃO' THEN 'PARECER DA JUNTA MEDICA'
