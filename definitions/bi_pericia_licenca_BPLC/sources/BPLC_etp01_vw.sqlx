      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'INIC.C/ ALTA ART.88' THEN 'PARECER DA JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'INIC.C/ ALTA ART.99' THEN 'PARECER DA JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'INICIAL' THEN 'PARECER DA JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'INICIAL ART.100' THEN 'PARECER DA JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'INICIAL ART.88' THEN 'PARECER DA JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'JUNTA' AND RESULTADO = 'INICIAL ART.99' THEN 'PARECER DA JUNTA MEDICA'
