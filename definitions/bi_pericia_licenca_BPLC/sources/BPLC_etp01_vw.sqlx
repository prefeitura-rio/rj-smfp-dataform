SELECT *, 
  CASE
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'NEGADA' THEN 'LICENCA NEGADA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'REG NAT' THEN 'LICENCA NEGADA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'INICIAL' THEN 'LICENÇA CONCEDIDA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'INICIAL COM ALTA' THEN 'LICENÇA CONCEDIDA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'MANTIDO RETORNO' THEN 'LICENCA PRORROGADA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'PRORROG COM ALTA' THEN 'LICENCA PRORROGADA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'PRORROG COM ALTA ADM' THEN 'LICENCA PRORROGADA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'PRORROGAÇÃO' THEN 'LICENCA PRORROGADA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ALTA' THEN 'ALTA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ALTA ADM' THEN 'ALTA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ALTA ADM ART 177X' THEN 'ALTA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ALTA ADMINISTRATIVA' THEN 'ALTA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ENCAM ESPEC' THEN 'ENCAMINHAMENTO AO PERITO ESPECIALISTA'
      WHEN SIGLA = 'AV ESPEC LM 88' THEN 'PARECER DO PERITO ESPECIALISTA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ENCAM `JRD EX-OFF' THEN 'ENCAMINHAMENTO A JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ENCAM À JUNTA ALTA' THEN 'ENCAMINHAMENTO A JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ENCAM JLPA' THEN 'ENCAMINHAMENTO A JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ENCAM JRD EX-OFF' THEN 'ENCAMINHAMENTO A JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ENCAM JUNTA DE ALTA' THEN 'ENCAMINHAMENTO A JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ENCAMINHA JUNTA' THEN 'ENCAMINHAMENTO A JUNTA MEDICA'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'EM EXIGENCIA' THEN 'ATENDIMENTO INICIADO POREM NAO CONCLUIDO (EM EXIGENCIA)'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'EM EXIGÊNCIA' THEN 'ATENDIMENTO INICIADO POREM NAO CONCLUIDO (EM EXIGENCIA)'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'EXIGENCIA' THEN 'ATENDIMENTO INICIADO POREM NAO CONCLUIDO (EM EXIGENCIA)'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'EXIGÊNCIA' THEN 'ATENDIMENTO INICIADO POREM NAO CONCLUIDO (EM EXIGENCIA)'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ALTA ADMINISTRATIVA' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'ASSINADO' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'DEFERIDO' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'DEVOLVIDO' THEN 'ADMINISTRATIVO'
      WHEN TIPO_ATENDIMENTO = 'LM' AND RESULTADO = 'INDEFERIDO' THEN 'ADMINISTRATIVO'
