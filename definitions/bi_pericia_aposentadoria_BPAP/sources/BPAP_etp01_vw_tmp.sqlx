config {
    type: "view",
    tags: ["BPAP"],
    name: "BPAP_etp01_vw_tmp",
    description: ""
}

SELECT *,
   CASE
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP ACID TRAB EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP ACID TRAB S/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP DEF' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF ALTA ART 88' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF ALTA ART 99' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF FALEC' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF=LTS 6 MESES' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF=READAPTAÇÃO' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF-LTS 6 MESES' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INT §1º 92 EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INT §1º 92 S/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INT 92 C/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INT 92 S/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INT 92 S/EC70/EP' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP PROPORC EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP PROPORC S/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP PROPORC S/EC70 EP' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'RET AP INDEF' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'RET AP INDEF=RD' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'RET AP INT 92 C/EC70' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'RET AP INT 92 S/EC70' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'RET AP PROP EC70' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'RET AP PROP S/EC70' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'REVISÃO DE JLPA' THEN 'NECESSIDADE DE REAVALIAÇÃO'
      WHEN SIGLA = 'JUNTA RECURSO REV APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO' THEN 'PROCESSO DE REVERSÃO DE APOSENTADORIA'
      WHEN SIGLA = 'JUNTA RECURSO REV APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO' THEN 'PROCESSO DE REVERSÃO DE APOSENTADORIA'
      WHEN SIGLA = 'JUNTA RECURSO REV APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO' THEN 'PROCESSO DE REVERSÃO DE APOSENTADORIA'
      WHEN SIGLA = 'JUNTA REV APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO' THEN 'PROCESSO DE REVERSÃO DE APOSENTADORIA'
      WHEN SIGLA = 'JUNTA REV APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO' THEN 'PROCESSO DE REVERSÃO DE APOSENTADORIA'
      WHEN SIGLA = 'Retif AP' AND DECISAO_PHOMOLOGADOR_RESULT IS NULL THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_CODIGO IS NULL THEN 'JUNTA SEM HOMOLOGACAO'
      ELSE 'VERIFICAR'
   END RESULTADO_AGRUP_PHOMOLOG
 , CASE
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP ACID TRAB EC70' THEN 'APOSENTADORIA DEFERIDA (ACIDENTE DE TRABALHO)'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP ACID TRAB S/EC70' THEN 'APOSENTADORIA DEFERIDA (ACIDENTE DE TRABALHO)'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP DEF' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF ALTA ART 88' THEN 'ALTA DA LICENÇA MÉDICA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF ALTA ART 99' THEN 'ALTA DA LICENÇA MÉDICA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF FALEC' THEN 'FALECIMENTO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF=LTS 6 MESES' THEN 'PRORROGAÇÃO DA LICENÇA MÉDICA POR MAIS 6 MESES'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF=READAPTAÇÃO' THEN 'READAPTAÇÃO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INDEF-LTS 6 MESES' THEN 'PRORROGAÇÃO DA LICENÇA MÉDICA POR MAIS 6 MESES'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INT §1º 92 EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INT §1º 92 S/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INT 92 C/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INT 92 S/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP INT 92 S/EC70/EP' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP PROPORC EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP PROPORC S/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'AP PROPORC S/EC70 EP' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'RET AP INDEF' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'RET AP INDEF=RD' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'RET AP INT 92 C/EC70' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'RET AP INT 92 S/EC70' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'RET AP PROP EC70' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'RET AP PROP S/EC70' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'REVISÃO DE JLPA' THEN 'NECESSIDADE DE REAVALIAÇÃO POR JUNTA MÉDICA'
      WHEN SIGLA = 'JUNTA RECURSO REV APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO' THEN 'REVERSÃO DEFERIDA'
      WHEN SIGLA = 'JUNTA RECURSO REV APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO' THEN 'REVERSÃO INDEFERIDA'
      WHEN SIGLA = 'JUNTA RECURSO REV APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO' THEN 'REVERSÃO INDEFERIDA'
      WHEN SIGLA = 'JUNTA REV APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'DEFERIDO' THEN 'REVERSÃO DEFERIDA'
      WHEN SIGLA = 'JUNTA REV APOSENT' AND DECISAO_PHOMOLOGADOR_RESULT = 'INDEFERIDO' THEN 'REVERSÃO INDEFERIDA'
      WHEN SIGLA = 'Retif AP' AND DECISAO_PHOMOLOGADOR_RESULT IS NULL THEN 'ADMINISTRATIVO'
      WHEN DECISAO_PHOMOLOGADOR_CODIGO IS NULL THEN 'JUNTA SEM HOMOLOGACAO'
      ELSE 'VERIFICAR'
   END RESULTADO_PADRAO_PHOMOLOG
 , CASE
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP DEF' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP EXIG' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INDEF' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INDEF ALTA ART 88' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INDEF ALTA ART 99' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INDEF=LTS 6 MESES' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INDEF=READAPTAÇÃO' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INDEF-LTS 6 MESES' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INT 92 C/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INT 92 S/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP PROPORC EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP PROPORC S/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'REVISÃO DE JLPA' THEN 'REVISÃO DE APOSENTADORIA POR INVALIDEZ'
      WHEN SIGLA = 'Retif AP' AND DECISAO_PERITOJUNTA = 'RD' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA RECURSO REV APOSENT' AND DECISAO_PERITOJUNTA = 'DEFERIDO' THEN 'PROCESSO DE REVERSÃO DE APOSENTADORIA'
      WHEN SIGLA = 'JUNTA RECURSO REV APOSENT' AND DECISAO_PERITOJUNTA = 'INDEFERIDO' THEN 'PROCESSO DE REVERSÃO DE APOSENTADORIA'
      WHEN SIGLA = 'JUNTA REV APOSENT' AND DECISAO_PERITOJUNTA = 'DEFERIDO' THEN 'PROCESSO DE REVERSÃO DE APOSENTADORIA'
      WHEN SIGLA = 'JUNTA REV APOSENT' AND DECISAO_PERITOJUNTA = 'INDEFERIDO' THEN 'PROCESSO DE REVERSÃO DE APOSENTADORIA'
      ELSE 'VERIFICAR'
   END RESULTADO_AGRUP_PERITOS
 , CASE
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP DEF' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP EXIG' THEN 'ATENDIMENTO INICIADO PORÉM NÃO CONCLUÍDO ("EM EXIGÊNCIA")'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INDEF' THEN 'APOSENTADORIA INDEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INDEF ALTA ART 88' THEN 'ALTA DA LICENÇA MÉDICA (SAÚDE DO SERVIDOR)'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INDEF ALTA ART 99' THEN 'ALTA DA LICENÇA MÉDICA (ACIDENTE DE TRABALHO)'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INDEF=LTS 6 MESES' THEN 'PRORROGAÇÃO DA LICENÇA MÉDICA POR MAIS 6 MESES'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INDEF=READAPTAÇÃO' THEN 'READAPTAÇÃO'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INDEF-LTS 6 MESES' THEN 'PRORROGAÇÃO DA LICENÇA MÉDICA POR MAIS 6 MESES'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INT 92 C/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP INT 92 S/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP PROPORC EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'AP PROPORC S/EC70' THEN 'APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA APOSENT' AND DECISAO_PERITOJUNTA = 'REVISÃO DE JLPA' THEN 'REVISÃO DE APOSENTADORIA POR INVALIDEZ'
      WHEN SIGLA = 'Retif AP' AND DECISAO_PERITOJUNTA = 'RD' THEN 'ADMINISTRATIVO'
      WHEN SIGLA = 'JUNTA RECURSO REV APOSENT' AND DECISAO_PERITOJUNTA = 'DEFERIDO' THEN 'RECURSO DE REVERSÃO DE APOSENTADORIA DEFERIDO'
      WHEN SIGLA = 'JUNTA RECURSO REV APOSENT' AND DECISAO_PERITOJUNTA = 'INDEFERIDO' THEN 'RECURSO DE REVERSÃO DE APOSENTADORIA INDEFERIDO'
      WHEN SIGLA = 'JUNTA REV APOSENT' AND DECISAO_PERITOJUNTA = 'DEFERIDO' THEN 'REVERSÃO DE APOSENTADORIA DEFERIDA'
      WHEN SIGLA = 'JUNTA REV APOSENT' AND DECISAO_PERITOJUNTA = 'INDEFERIDO' THEN 'REVERSÃO DE APOSENTADORIA INDEFERIDA'
      ELSE 'VERIFICAR'
   END RESULTADO_PADRAO_PERITOS
FROM ${ref("bi_pericia_aposentadoria_original_2")}

